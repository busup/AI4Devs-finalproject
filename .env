# =============================================================
# Route Searcher — Local Development Environment Template
# Copy this file to .env and fill in your own values.
# NEVER commit the .env file to version control.
# =============================================================

# ---- General -----------------------------------------------
APP_ENV=local
APP_DEBUG=true

# ---- MySQL root --------------------------------------------
MYSQL_ROOT_PASSWORD=changeme_root

# ---- ms-router database ------------------------------------
ROUTER_DB_NAME=ms-router
ROUTER_DB_USER=ms_router_user
ROUTER_DB_PASSWORD=changeme_router

# ---- ms-planifications database ----------------------------
PLANIFICATIONS_DB_NAME=ms-planifications
PLANIFICATIONS_DB_USER=ms_planifications_user
PLANIFICATIONS_DB_PASSWORD=changeme_planifications

# ---- MySQL port binding on host (optional override) --------
MYSQL_HOST_PORT=3306

# ---- ms-router Laravel app ---------------------------------
# Generate with: php artisan key:generate --show
MS_ROUTER_APP_KEY=base64:CHANGE_ME_ROUTER_KEY==
MS_ROUTER_PORT=8001

# ---- ms-planifications Laravel app -------------------------
# Generate with: php artisan key:generate --show
MS_PLANIFICATIONS_APP_KEY=base64:CHANGE_ME_PLANIFICATIONS_KEY==
MS_PLANIFICATIONS_PORT=8002
