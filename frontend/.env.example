# URL base del API (sin barra final). Ejemplos:
# - Gateway documental: https://api.routesearch.busup.org/api/v1
# - ms-router directo (CORS habilitado en ms-router): http://localhost:8001/api/v1
# - Proxy Vite (vite.config.ts → /dev-ms-router): /dev-ms-router/api/v1
VITE_API_BASE_URL=

# Horarios por snapshot (ms-planifications). Ej.: http://localhost:8002/api/v1 o /dev-ms-planifications/api/v1 (proxy Vite)
VITE_API_PLANIFICATIONS_BASE_URL=

# false = datos reales desde ms-router (POST /search/routes, GET /routes/{id}/schedules)
# true = mocks locales (lista vacía)
VITE_USE_MOCK_API=true

# Google Maps JavaScript API (mapa + Places + ruta a pie). Crea una clave en Google Cloud Console
# y restringe por HTTP referrer (ej. http://localhost:5173/*). Habilita: Maps JavaScript API, Places API,
# Directions API (recorrido peatonal hasta la parada en el mapa).
VITE_GOOGLE_MAPS_API_KEY=
