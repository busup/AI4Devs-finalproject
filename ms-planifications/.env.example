APP_NAME="ms-planifications"
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE==
APP_URL=http://localhost:8002

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (MySQL) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ms-planifications
DB_USERNAME=ms_planifications_user
DB_PASSWORD=changeme_planifications

# ---- Inter-service ----------------------------------------
# URL of ms-router (used to validate RouteSnapshot references)
ROUTER_SERVICE_URL=http://localhost:8001

# ---- Cache / Session (file driver — no Redis needed locally)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
